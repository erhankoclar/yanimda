# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabanı (yalnızca PostgreSQL). docker compose up -d db ile başlatılan veritabanı 5433 portundadır.
DATABASE_URL=postgres://yanimda:yanimda@localhost:5433/yanimda

# Frontend geliştirme sunucusu
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API dokümantasyonu (Swagger /api/docs/, ReDoc /api/redoc/); boşsa DEBUG değeri kullanılır
API_DOCS_ENABLED=True

# Fabrikaların/testlerin ve demo verisinin kurgusal hesaplara yazdığı parolalar
TEST_USER_PASSWORD=Yanimda-Guclu-2026
DEMO_USER_PASSWORD=Kurgusal-Demo-2026
