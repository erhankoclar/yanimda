#, python-format
msgid "Care default data setup failed: %(error)s"
msgstr "Bakım modülü varsayılan veri kurulumu başarısız oldu: %(error)s"

#, python-format
msgid ""
"All care default data operations completed. Created: %(created)d, Updated: "
"%(updated)d."
msgstr ""
"Tüm bakım modülü varsayılan veri işlemleri tamamlandı. Oluşturulan: "
"%(created)d, Güncellenen: %(updated)d."

