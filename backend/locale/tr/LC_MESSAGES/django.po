msgid "Care default data setup failed: %(error)s"
msgstr "Bakım modülü varsayılan veri kurulumu başarısız oldu: %(error)s"

#, python-format
msgid ""
"All care default data operations completed. Created: %(created)d, Updated: "
"%(updated)d."
msgstr ""
"Tüm bakım modülü varsayılan veri işlemleri tamamlandı. Oluşturulan: "
"%(created)d, Güncellenen: %(updated)d."

msgid ""
"Creates fictional demo inquiries and applications for the last days. Runs "
"only with DEBUG enabled."
msgstr ""
"Son günler için kurgusal demo hızlı talepleri ve başvuruları oluşturur. "
"Yalnızca DEBUG açıkken çalışır."

msgid "Number of past days to fill."
msgstr "Doldurulacak geçmiş gün sayısı."

msgid "Delete the existing demo data and create it again."
msgstr "Mevcut demo verisini silip yeniden oluştur."

msgid "Demo data can only be created when DEBUG is enabled."
msgstr "Demo verisi yalnızca DEBUG açıkken oluşturulabilir."

msgid "Existing demo data removal"
msgstr "Mevcut demo verisinin silinmesi"

msgid "Demo inquiries and applications"
msgstr "Demo hızlı talepleri ve başvuruları"

msgid "CARE DEMO DATA SETUP STARTED"
msgstr "BAKIM DEMO VERİSİ KURULUMU BAŞLATILDI"

#, python-format
msgid "Care demo data setup failed: %(error)s"
msgstr "Bakım demo verisi kurulumu başarısız oldu: %(error)s"

#, python-format
msgid ""
"All care demo data operations completed. Created: %(created)d, Updated: "
"%(updated)d."
msgstr ""
"Tüm bakım demo verisi işlemleri tamamlandı. Oluşturulan: %(created)d, "
"Güncellenen: %(updated)d."

#, python-format
msgid "Removed rows: %(count)d."
msgstr "Silinen satır: %(count)d."

msgid ""
"Identifier of the service type; the key used in <code>by_service</code>."
msgstr ""
"Hizmet türü kimliği; <code>by_service</code> içinde anahtar olarak "
"kullanılır."

msgid "Service name in the request language."
msgstr "İstek dilindeki hizmet adı."

msgid "Records of this service with a location."
msgstr "Bu hizmetin konumlu kayıtları."

msgid "District or neighbourhood identifier; used by the list filters."
msgstr "İlçe veya mahalle kimliği; liste süzgeçlerinde kullanılır."

msgid "OpenStreetMap relation id; matches the polygon in the boundary files."
msgstr "OpenStreetMap ilişki kimliği; sınır dosyalarındaki poligonla eşleşir."

msgid "Name of the area as written in Turkish."
msgstr "Alanın Türkçe yazılışı."

msgid "Records in the area."
msgstr "Alandaki kayıtlar."

msgid ""
"Records per service: service id (as text) to count. Services without records "
"are left out."
msgstr ""
"Hizmet başına kayıtlar: hizmet kimliğinden (metin olarak) sayıya eşleme. "
"Kaydı olmayan hizmetler yer almaz."

msgid "Identifier of the district the neighbourhood belongs to."
msgstr "Mahallenin bağlı olduğu ilçenin kimliği."

msgid "All counted records with a location in Istanbul."
msgstr "İstanbul'da konumu olan tüm sayılan kayıtlar."

msgid "Active services with their counts."
msgstr "Sayılarıyla aktif hizmetler."

msgid "Every district, also with zero records."
msgstr "Kaydı sıfır olanlar dahil tüm ilçeler."

msgid "Neighbourhoods with at least one record, most first."
msgstr "En az bir kaydı olan mahalleler, çoktan aza."

